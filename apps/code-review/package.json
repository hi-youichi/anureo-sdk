{
  "name": "@anureo/code-review",
  "version": "0.2.0",
  "description": "Module-based parallel code review powered by Anureo workflows",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hi-youichi/anureo-sdk.git",
    "directory": "apps/code-review"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "anureo-review": "./bin/anureo-review.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "bun test tests"
  },
  "dependencies": {
    "@anureo/adapter-claude": "workspace:*",
    "@anureo/adapter-codex": "workspace:*",
    "@anureo/adapter-hermes": "workspace:*",
    "@anureo/adapter-pi": "workspace:*",
    "@anureo/sdk": "workspace:*",
    "@anureo/workflow": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@anureo/conformance": "workspace:*",
    "@anureo/protocol": "workspace:*"
  },
  "engines": {
    "node": ">=22",
    "bun": ">=1.4.2"
  }
}

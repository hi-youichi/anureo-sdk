{
  "name": "@anureo/adapter-codex",
  "description": "Anureo SDK adapter for the Codex CLI app-server protocol over stdio JSONL",
  "version": "0.2.0",
  "license": "Apache-2.0",
  "keywords": [
    "anureo",
    "ahp",
    "harness",
    "agent",
    "codex",
    "openai"
  ],
  "homepage": "https://github.com/hi-youichi/anureo-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hi-youichi/anureo-sdk.git",
    "directory": "packages/codex"
  },
  "bugs": {
    "url": "https://github.com/hi-youichi/anureo-sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./jsonl": "./src/jsonl.ts",
    "./mapping": "./src/mapping.ts",
    "./catalog": "./src/catalog.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "bun test tests",
    "protocol:check": "bun scripts/protocol-check.ts",
    "smoke": "bun scripts/smoke.ts"
  },
  "dependencies": {
    "@anureo/sdk": "workspace:*",
    "@anureo/protocol": "workspace:*"
  },
  "devDependencies": {
    "@anureo/conformance": "workspace:*"
  },
  "engines": {
    "node": ">=22"
  }
}

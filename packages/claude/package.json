{
  "name": "@anureo/adapter-claude",
  "description": "Anureo SDK adapter for the official Claude Agent SDK",
  "version": "0.2.0",
  "license": "Apache-2.0",
  "keywords": [
    "anureo",
    "ahp",
    "harness",
    "agent",
    "claude",
    "anthropic"
  ],
  "homepage": "https://github.com/hi-youichi/anureo-sdk#readme",
  "repository": {
    "type": "git",

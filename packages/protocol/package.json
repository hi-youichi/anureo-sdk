{
  "name": "@anureo/protocol",
  "description": "Anureo Harness Protocol (AHP) v1: JSON Schema, generated TypeScript types, runtime validation, and version/capability negotiation",
  "version": "0.2.0",
  "license": "Apache-2.0",
  "keywords": [
    "anureo",
    "ahp",
    "harness",
    "agent",
    "protocol",
    "json-rpc",
    "json-schema"
  ],
  "homepage": "https://github.com/hi-youichi/anureo-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hi-youichi/anureo-sdk.git",
    "directory": "packages/protocol"
  },
  "bugs": {
    "url": "https://github.com/hi-youichi/anureo-sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./schema/v1/ahp.schema.json"
  },
  "scripts": {
    "generate": "bun scripts/generate.ts",
    "generate:check": "bun scripts/generate.ts --check",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "bun test tests"
  },
  "dependencies": {
    "ajv": "8.20.0"
  },
  "engines": {
    "node": ">=22"
  }
}

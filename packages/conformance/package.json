{
  "name": "@anureo/conformance",
  "description": "Shared conformance suite and scripted fixtures for Anureo SDK adapters and AHP implementations",
  "version": "0.2.0",
  "license": "Apache-2.0",
  "keywords": [
    "anureo",
    "ahp",
    "harness",
    "agent",
    "conformance",
    "testing"
  ],
  "homepage": "https://github.com/hi-youichi/anureo-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hi-youichi/anureo-sdk.git",
    "directory": "packages/conformance"
  },
  "bugs": {
    "url": "https://github.com/hi-youichi/anureo-sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./fake": "./src/fake.ts",
    "./fixtures": "./src/fixtures.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "bun test src"
  },
  "dependencies": {
    "@anureo/protocol": "workspace:*",
    "@anureo/sdk": "workspace:*"
  },
  "engines": {
    "node": ">=22"
  }
}

{
  "name": "@anureo/sdk",
  "description": "Runtime core of the Anureo SDK: unified HarnessRuntime and HarnessSession over any adapter, enforcing AHP semantics",
  "version": "0.2.0",
  "license": "Apache-2.0",
  "keywords": [
    "anureo",
    "ahp",
    "harness",
    "agent",
    "sdk",
    "runtime"
  ],
  "homepage": "https://github.com/hi-youichi/anureo-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hi-youichi/anureo-sdk.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/hi-youichi/anureo-sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./process": "./src/process.ts",
    "./queue": "./src/queue.ts",
    "./diagnostics": "./src/diagnostics.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "bun test src"
  },
  "dependencies": {
    "@anureo/protocol": "workspace:*"
  },
  "engines": {
    "node": ">=22"
  }
}

{
  "name": "anureo-sdk-workspace",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=22",
    "bun": ">=1.4.2"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "generate": "bun run --filter @anureo/protocol generate",
    "generate:check": "bun run --filter @anureo/protocol generate:check",
    "protocol:check": "bun run --filter @anureo/adapter-codex protocol:check",
    "typecheck": "bun run --filter '@anureo/*' typecheck",
    "typecheck:tooling": "tsc --noEmit",
    "test": "bun test --timeout 15000 packages",
    "example": "bun examples/greeting.ts",
    "example:dsh": "bun examples/dsh.ts",
    "example:workflow": "bun examples/workflow.ts",
    "example:workflow-schema": "bun examples/workflow-structured.ts",
    "example:workflow-tool-schema": "bun examples/workflow-output-tools.ts",
    "example:pi-tool-schema": "bun examples/pi-structured-live.ts",
    "example:workflow-persistence": "bun examples/workflow-persistence.ts",
    "review": "bun packages/code-review/bin/anureo-review.ts",
    "review:readability": "bun packages/code-review/bin/anureo-review.ts --dimension D12",
    "fix:readability": "bun packages/code-review/bin/anureo-review.ts fix",
    "example:schema": "bun examples/structured-output.ts",
    "example:hermes": "bun examples/hermes.ts"
  },
  "devDependencies": {
    "@anureo/code-review": "workspace:*",
    "@anureo/sdk": "workspace:*",
    "@anureo/conformance": "workspace:*",
    "@anureo/adapter-codex": "workspace:*",
    "@anureo/adapter-claude": "workspace:*",
    "@types/bun": "1.4.0",
    "@types/node": "22.15.3",
    "typescript": "5.8.3",
    "@anureo/protocol": "workspace:*",
    "@anureo/adapter-acp": "workspace:*",
    "@anureo/adapter-pi": "workspace:*",
    "@anureo/workflow": "workspace:*",
    "zod": "4.6.7",
    "@anureo/adapter-hermes": "workspace:*"
  }
}
